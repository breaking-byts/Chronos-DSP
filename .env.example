# Runtime settings
RUNTIME_ENV=prod
PHX_SERVER=true
PHX_HOST=chronos.example.com
PORT=4000

# Public origin allowlist. Optional: defaults to the origin derived from
# PHX_HOST, PHX_SCHEME, and PHX_URL_PORT.
# CHECK_ORIGIN=https://chronos.example.com

# Required in production: at least 64 bytes.
# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=replace_with_a_random_secret_of_at_least_64_bytes

# Optional signing salts. When unset, both are derived from SECRET_KEY_BASE.
# Set them explicitly if you need to rotate them independently.
# LIVEVIEW_SIGNING_SALT=replace_with_random_liveview_salt
# SESSION_SIGNING_SALT=replace_with_random_session_salt

# Local plain-HTTP containers only (docker-compose.yml sets these already):
# FORCE_SSL=false
# PHX_SCHEME=http
# PHX_URL_PORT=4000

# Optional logging level: debug, info, notice, warning, error, critical.
# LOG_LEVEL=info

# Optional Rustler build overrides
# ERL_EI_INCLUDE_DIR=/path/to/erlang/usr/include
# ERL_EI_LIBDIR=/path/to/erlang/usr/lib
