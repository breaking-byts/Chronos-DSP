#!/usr/bin/env bash
# Release smoke test (#18): boot a fresh build and verify NIF-loaded readiness,
# the dashboard HTML, and static assets. Catches missing assets or a NIF that
# failed to load (the engine badge reads the same nif_loaded flag as /readyz).
#
#   bin/smoke            # docker build the release image, then smoke it
#   bin/smoke IMAGE      # smoke an existing image (e.g. the pushed GHCR tag)
#   bin/smoke --local    # build a fresh mix release and smoke it (no docker)
#
# SMOKE_PORT overrides the host port (default 4000).
set -euo pipefail

PORT="${SMOKE_PORT:-4000}"
BASE="http://127.0.0.1:${PORT}"
SECRET="$(openssl rand -base64 48)"
MODE="docker"
IMAGE="chronos-dsp:smoke"
CONTAINER="chronos-smoke-$$"
REL="_build/prod/rel/chronos/bin/chronos"

cleanup() {
  if [ "$MODE" = "local" ] && [ -x "$REL" ]; then
    "$REL" stop >/dev/null 2>&1 || true
  fi
  docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
}
trap cleanup EXIT

case "${1:-}" in
  --local) MODE="local" ;;
  "") docker build -t "$IMAGE" . ;;
  *) IMAGE="$1" ;;
esac

if [ "$MODE" = "local" ]; then
  echo "==> Building fresh mix release (prod)"
  MIX_ENV=prod mix deps.get >/dev/null
  MIX_ENV=prod mix release --overwrite >/dev/null
  echo "==> Starting release daemon on port $PORT"
  SECRET_KEY_BASE="$SECRET" PHX_SERVER=true PHX_HOST=localhost \
    FORCE_SSL=false PHX_SCHEME=http PORT="$PORT" \
    "$REL" daemon
else
  echo "==> Starting $IMAGE"
  docker run -d --name "$CONTAINER" -p "${PORT}:4000" \
    -e SECRET_KEY_BASE="$SECRET" -e PHX_SERVER=true -e PHX_HOST=localhost \
    -e FORCE_SSL=false -e PHX_SCHEME=http "$IMAGE" >/dev/null
fi

echo "==> Polling /readyz for NIF-loaded readiness (require_nif=true)"
body=""
ready=0
for _ in $(seq 1 60); do
  body="$(curl -fsS "$BASE/readyz" 2>/dev/null || true)"
  if echo "$body" | grep -q '"nif_loaded":true' && echo "$body" | grep -q '"require_nif":true'; then
    ready=1
    break
  fi
  sleep 2
done
if [ "$ready" -ne 1 ]; then
  echo "FAIL: /readyz never reported nif_loaded=true with require_nif=true"
  [ "$MODE" = "docker" ] && docker logs "$CONTAINER" 2>&1 | tail -40
  exit 1
fi
echo "    $body"

echo "==> /healthz"
curl -fsS "$BASE/healthz" | grep -q '"status":"ok"'

echo "==> dashboard HTML"
html="$(curl -fsS "$BASE/")"
echo "$html" | grep -q "Chronos-DSP"
echo "$html" | grep -q "/assets/app.js"

echo "==> static assets"
curl -fsS "$BASE/assets/app.js" >/dev/null
curl -fsS "$BASE/assets/app.css" >/dev/null

echo "==> engine badge data path: NIF loaded (not reference)"
echo "$body" | grep -q '"nif_loaded":true'

echo "PASS: release smoke green (NIF loaded, dashboard + assets served)"
